# Copie estas variables al administrador de secretos del servidor.
# No guarde el archivo real con credenciales dentro de la aplicación.
IMFOHSA_ODOO_URL=https://odoo.empresa.com
IMFOHSA_ODOO_DATABASE=nombre_base_odoo
IMFOHSA_ODOO_USERNAME=integracion.imfohsa@empresa.com
IMFOHSA_ODOO_API_KEY=REEMPLAZAR_EN_EL_SERVIDOR

# Campo personalizado de sale.order que recibirá el estado logístico.
# Debe existir previamente en Odoo. Ejemplo: x_imfohsa_delivery_status
IMFOHSA_ODOO_STATUS_FIELD=x_imfohsa_delivery_status

# Configuración de la plataforma.
IMFOHSA_ROOT=/opt/imfohsa
IMFOHSA_PORT=8946
IMFOHSA_ENV=production
